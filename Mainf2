#include <avr/interrupt.h>
#include <stdio.h>
#include <avr/io.h>

typedef struct USARTRX
{
	char receiver_buffer;
	unsigned char status;
	unsigned char receive: 1;
	unsigned char error:  1;
} USARTRX_st;

volatile USARTRX_st rxUSART = {0, 0, 0, 0};
volatile unsigned char cont_botoes;
const unsigned char tabela[] = {0XC0, 0XF9, 0XA4, 0XB0, 0X99, 0X92, 0x82, 0XF8, 0x80, 0x90, 0xFF, 0xBF};
unsigned char vect_display[4] = {0, 10, 0, 0};
unsigned char p_display = 0;
unsigned char pwm = 0;
signed char sentido = 1;
volatile unsigned char modo_funcionamento = 0; 
char buffer[50];

void inicio(void)
{
	DDRC = 0xFF;
	PORTC = 0xFF;
	DDRA = 0b11000000;
	PORTA = 0b00111111;
	DDRB = 0b11100000;
	PORTB = 0b00100000;
	OCR0 = 77;
	TCCR0 = 0b00001111;
	TIMSK = 0b00000010;
	OCR2 = 0;
	TCCR2 = 0B01100011;
	sei();
	UBRR1H=0;
	UBRR1L=103;
	USR1A=0b00000000;
	USR1B=0b10011000;
	USR1C=0b00001110;
}

void display(void)
{
	PORTA = p_display << 6;
	PORTC = tabela[vect_display[p_display]];
	p_display++;
	if(p_display == 4)
	p_display = 0;
}

ISR(USART0_RX_vect)
{
	caracter=UDR1;
	flag_Rx=1;
}

ISR(TIMER0_COMP_vect)
{
	display();
	cont_botoes--;
}

void processar_display(void)
{
	vect_display[0] = 10;
	
	if(sentido == -1)
	vect_display[1] = 11;
	else
	vect_display[1] = 10;
	
	if(pwm == 100)
	{
		vect_display[2] = 9;
		vect_display[3] = 9;
	}
	else
	{
		vect_display[2] = pwm / 10;
		vect_display[3] = pwm % 10;
	}
}

void processar_sw(void)
{
	if((PINA & 0b00000001) == 0)
	{
		cont_botoes=1;
		while(cont_botoes!=0);
		if((PINA & 0b00000001) == 0)
		{
			if(pwm+5<=100)
			pwm = pwm + 5;
			while((PINA & 0b00000001) == 0);
		}
	}
	
	if((PINA & 0b00000010) == 0)
	{
		if(pwm-5>=0)
		pwm = pwm - 5;
		while((PINA & 0b00000010) == 0);
	}
	
	if((PINA & 0b00000100) == 0)
	{
		pwm = 25;
	}
	
	if((PINA & 0b00001000) == 0)
	{
		pwm = 50;
	}
	
	if((PINA & 0b00010000) == 0)
	{
		cont_botoes=1;
		while(cont_botoes!=0);
		if((PINA & 0b00010000) == 0)
		{
			sentido=-sentido;
			OCR2=0;
			cont_botoes=50;
			while(cont_botoes!=0);
			if(sentido == 1)
			PORTB = (PORTB & 0b10011111) | 0b00100000;
			else
			PORTB = (PORTB & 0b10011111) | 0b01000000;
		}
		
		
		while((PINA & 0b00010000) == 0);
	}
	
	if((PINA & 0b00100000) == 0)
	{
		pwm = 0;
	}
	
	OCR2 = (pwm * 255) / 100;
}

void enviar_buffer(void)
{
	unsigned char i=0;
	while(buffer [i]!=0)
	{
		while (!(USR1A & (1<<UDRE)));
		{
			UDR1=buffer[i];
			i++;
		}
	}
}



void processar_comando_USART(char comando)
{
	switch(comando)
	{
		case 'D':
		case 'd':
		modo_funcionamento = 0;
		digito[0] = 0;
		send_message("Modo Digital ativado\n\r");
		break;
		
		case 'S':
		case 's':
		modo_funcionamento = 1;
		digito[0] = 1;
		send_message("Modo Switches ativado\n\r");
		send_message("Use os botoes SW1-SW6 para controle\n\r");
		break;
				
		case 'P':
		case 'p':
		pwm=0;
		OCR2 = (pwm * 255) / 100;
		send_message("Motor parado\n\r");
		break;
		
		case '1':
		if (modo_funcionamento == 0) {
			atualizar_velocidade(25);
			send_message("Velocidade definida para 25%\n\r");
		}
		break;
		
		case '2':
		if (modo_funcionamento == 0) {
			atualizar_velocidade(50);
			send_message("Velocidade definida para 50%\n\r");
		}
		break;
		
		case '+':
		if (modo_funcionamento == 0 && velocidade <= 95) {
			atualizar_velocidade(velocidade + 5);
			sprintf(transmit_buffer, "Velocidade aumentada para %d%%\n\r", velocidade);
			send_message(transmit_buffer);
			} else if (modo_funcionamento == 0 && velocidade == 100) {
			send_message("Velocidade ja esta no maximo (100%)\n\r");
		}
		break;
		
		case '-':
		if (modo_funcionamento == 0 && velocidade >= 5) {
			atualizar_velocidade(velocidade - 5);
			sprintf(transmit_buffer, "Velocidade diminuida para %d%%\n\r", velocidade);
			send_message(transmit_buffer);
			} else if (modo_funcionamento == 0 && velocidade == 0) {
			send_message("Velocidade ja esta no minimo (0%)\n\r");
		}
		break;
		
		case 'I':
		case 'i':
		inverter_direcao();
		if(sentido == 1)
		send_message("Sentido: Invertido\n\r");
		else
		send_message("Sentido: Normal\n\r");
		break;
		
		case 'B':
		case 'b':
		sprintf(transmit_buffer, "=== ESTADO ATUAL ===\n\r");
		send_message(transmit_buffer);
		sprintf(transmit_buffer, "Modo: ");
		send_message(transmit_buffer);
		if (modo_funcionamento == 0) send_message("Digital\n\r");
		else if (modo_funcionamento == 1) send_message("Switches\n\r");
		else send_message("Analogico\n\r");
		
		sprintf(transmit_buffer, "Velocidade: %d%%\n\r", velocidade);
		send_message(transmit_buffer);
		
		sprintf(transmit_buffer, "Sentido: ");
		send_message(transmit_buffer);
		if (sentido == 0) send_message("Normal\n\r");
		else send_message("Invertido\n\r");
		
		sprintf(transmit_buffer, "PWM: %d/255\n\r", pwm_val);
		send_message(transmit_buffer);
		
		sprintf(transmit_buffer, "Display: %d-%d%d\n\r",
		digito[0], digito[2], digito[3]);
		send_message(transmit_buffer);
		break;
		
		case '\r':
		case '\n':
		// Ignora carriage return e line feed
		break;
		
		default:
		sprintf(transmit_buffer, "Comando invalido: '%c' (0x%02X)\n\r", comando, comando);
		send_message(transmit_buffer);
		send_message("Use D, S, A, P, I, B, +, -, 1, 2\n\r");
		break;
	}
}
int main(void)
{
	inicio();
	while(1)
	{
		processar_sw();
		processar_display();
	}
}

